{
  "manifest_version": 3,
  "name": "Better Xitter",
  "description": "Improve your x.com experience",
  "version": "0.3.4",
  "author": "WadeGrimridge",
  "homepage_url": "https://github.com/NotWadeGrimridge/better-xitter",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better Xitter settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://x.com/*",
        "https://mobile.x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://mobile.twitter.com/*",
    "https://x.com/*",
    "https://mobile.x.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://x.com/*",
        "https://mobile.x.com/*"
      ],
      "resources": [
        "tweet-info/tweet_info_page.js",
        "hide-affiliates/home_timeline_xhr_hook.js",
        "mute-affiliates/affiliates_page_xhr_hook.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "better-xitter@grimridge.net",
      "strict_min_version": "140.0"
    }
  }
}
