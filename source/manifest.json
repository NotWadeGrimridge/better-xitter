{
  "manifest_version": 3,
  "name": "better-xitter",
  "description": "Improve your x.com experience",
  "version": "0.1",
  "action": {
    "default_popup": "popup.html",
    "default_title": "better-xitter settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage"
  ]
}
