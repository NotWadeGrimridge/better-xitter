{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext",
      "deno.ns"
    ],
    "types": [
      "npm:@types/chrome"
    ]
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.21",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@types/chrome": "npm:@types/chrome@^0.1.32",
    "fflate": "npm:fflate@^0.8.2"
  },
  "lint": {
    "exclude": ["dist"]
  },
  "fmt": {
    "exclude": ["dist"]
  },
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-run --watch scripts/build.ts",
    "build": "deno run --allow-read --allow-write --allow-run scripts/build.ts",
    "check": "deno check source/"
  }
}
